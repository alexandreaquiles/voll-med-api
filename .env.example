# Copie para .env. Os valores do banco batem com o docker-compose.yaml.
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=vollmed
DB_PASSWORD=vollmed
DB_DATABASE=vollmed

REDIS_URL=redis://localhost:6379

# Assina e verifica os tokens de login
SECRET_JWT=troque-este-segredo
# Só confere senhas gravadas no formato antigo (criptografia reversível), que o login converte para hash
SECRET_KEY_CRYPTO=troque-esta-chave
