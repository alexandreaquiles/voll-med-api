# Copie para .env. Os valores do banco batem com o docker-compose.yaml.
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=vollmed
DB_PASSWORD=vollmed
DB_DATABASE=vollmed

REDIS_URL=redis://localhost:6379

# SECRET_JWT e SECRET_KEY precisam ser iguais: os tokens são assinados com uma e verificados com a outra
SECRET_JWT=troque-este-segredo
SECRET_KEY=troque-este-segredo
SECRET_KEY_CRYPTO=troque-esta-chave
